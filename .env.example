# Copy to .env and fill in with your Powens application credentials.
# Get these from the Powens console: https://console.powens.com/

# Your Powens domain — either the short name ("myapp-sandbox") or the full host.
POWENS_DOMAIN=myapp-sandbox

# Application credentials (client_id / client_secret).
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Optional: an existing user access token. If omitted, create_user() mints one.
POWENS_ACCESS_TOKEN=

# --- Application (optional) ---
# APP_HOST=127.0.0.1
# APP_PORT=8000
# APP_HISTORY_MONTHS=36   # sliding window (months) used for analysis
# APP_DB_PATH=.powens_finance.db  # local store (balance history, overrides)
# APP_BASE_CURRENCY=EUR   # net worth only sums accounts held in this currency
# APP_ALLOW_REMOTE=1      # bind APP_HOST outside loopback WITHOUT the built-in
#                         # authentication — only behind an authenticating proxy

# --- Déploiement (Railway, Docker, NAS…) : voir docs/DEPLOIEMENT.md ---
# APP_HOST=0.0.0.0        # écouter au-delà de la loopback ; exige l'authentification
# APP_AUTH_USER=          # authentification HTTP de l'app. Sans elle, l'app refuse
# APP_AUTH_PASSWORD=      # de démarrer hors loopback (données bancaires en jeu).
#                         # Tirée au sort et JAMAIS réutilisée ailleurs : à défaut
#                         # d'APP_SESSION_SECRET, c'est elle qui signe les cookies
#                         # de session — l'app refuse de démarrer si elle est
#                         # devinable (< 24 caractères ou < 8 distincts).
# APP_SESSION_SECRET=     # clé de signature explicite : les sessions survivent
#                         # alors à un changement de mot de passe. Mêmes exigences.
# APP_TOTP_SECRET=        # second facteur (TOTP, ProtonPass/Google Authenticator).
#                         # Vide = mot de passe seul. Enrôler avec :
#                         #   uv run python scripts/setup_mfa.py --env
# APP_API_TOKEN=          # porte des appels NON interactifs (scripts/backup-prod.sh,
#                         # supervision) : un script ne peut pas produire de code à
#                         # six chiffres. Dès que le second facteur est actif, le mot
#                         # de passe ne les ouvre plus — ce jeton devient nécessaire.
# APP_SESSION_MAX_AGE_HOURS=24  # durée d'une session (défaut 24 h, borné 0,25–720)
# APP_DATA_DIR=/data      # base + token Powens. Sur Railway, inutile : attacher un
#                         # volume suffit (RAILWAY_VOLUME_MOUNT_PATH est injectée)
# APP_PUBLIC_URL=https://exemple.fr   # adresse du callback Powens ; sur Railway,
#                         # déduite de RAILWAY_PUBLIC_DOMAIN si absente
# APP_COLLECT_EVERY_HOURS=12          # collecte lancée par l'app elle-même ; 0 = jamais
# APP_NOTIFY_URL=         # POST JSON {title, message} : Home Assistant, ntfy, Gotify…
# APP_NOTIFY_TOKEN=       # envoyé en Authorization: Bearer
