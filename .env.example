# Copy to .env and fill in with your Powens application credentials.
# Get these from the Powens console: https://console.powens.com/

# Your Powens domain — either the short name ("myapp-sandbox") or the full host.
POWENS_DOMAIN=myapp-sandbox

# Application credentials (client_id / client_secret).
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=

# Optional: an existing user access token. If omitted, create_user() mints one.
POWENS_ACCESS_TOKEN=

# --- Application (optional) ---
# APP_HOST=127.0.0.1
# APP_PORT=8000
# APP_HISTORY_MONTHS=36   # sliding window (months) used for analysis
# APP_DB_PATH=.powens_finance.db  # local store (balance history, overrides)
# APP_BASE_CURRENCY=EUR   # net worth only sums accounts held in this currency
# APP_ALLOW_REMOTE=1      # required to bind APP_HOST outside loopback — the app
#                         # has NO authentication, only use it behind a proxy
