<?xml version="1.0" encoding="UTF-8"?>
<!--
  Collecte quotidienne des soldes et des valorisations.

  Pourquoi launchd et pas cron : si le Mac dort à l'heure prévue, launchd lance la tâche
  au réveil, alors que cron passe son tour. Une machine qui dort la nuit ne collecterait
  jamais rien avec cron.

  Installation :
      cp scripts/fr.jbartoli.powens-collector.plist ~/Library/LaunchAgents/
      # remplacer /CHEMIN/VERS par le chemin réel du dépôt
      launchctl load ~/Library/LaunchAgents/fr.jbartoli.powens-collector.plist
      launchctl start fr.jbartoli.powens-collector      # vérifier tout de suite

  Désinstallation :
      launchctl unload ~/Library/LaunchAgents/fr.jbartoli.powens-collector.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fr.jbartoli.powens-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/CHEMIN/VERS/pypowens/.venv/bin/python</string>
        <string>-m</string>
        <string>app.collector</string>
    </array>

    <!-- ``app`` n'est pas installé dans le venv (hors wheel) : il est importé depuis le
         dépôt, d'où le répertoire de travail et le PYTHONPATH. -->
    <key>WorkingDirectory</key>
    <string>/CHEMIN/VERS/pypowens</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/CHEMIN/VERS/pypowens</string>
    </dict>

    <!-- Trois créneaux, pas un seul : le solde du jour est la donnée périssable, et une
         journée où la machine n'était pas réveillée à l'heure dite est perdue pour
         toujours. Multiplier les tentatives multiplie les chances d'en attraper une.

         Attention à ne pas se tromper sur ce que ces quatre créneaux produisent : la clé
         primaire de ``balance_snapshot`` est (day, account_id), donc ils écrivent tous
         dans la MÊME case et le dernier passage de la journée écrase les précédents. Ce
         ne sont pas quatre mesures intraday, ce sont quatre chances d'en obtenir une.
         D'où l'ordre de préférence : plus le passage est tardif, plus le solde archivé est
         fidèle. 22 h reste donc le passage de référence — les places européennes ont
         clôturé et publié leurs VL du jour. À l'inverse, 9 h 30 archiverait une valeur
         d'avant-séance, soit à peu près la clôture de la veille : c'est un filet pour les
         jours où la machine dort le reste du temps, pas une mesure d'ouverture.

         Les valorisations de titres, elles, sont datées par l'API (``list_investment_history``)
         et ne dépendent donc pas de l'heure de collecte. Relancer le même jour ne coûte
         rien : ces écritures sont idempotentes (INSERT OR REPLACE) et ce sont des lectures
         côté Powens, aucune synchro bancaire forcée. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>13</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>22</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Le collecteur rattrape depuis le dernier jour archivé : un réveil tardif ou une
         semaine d'absence se comblent tout seuls pour les valorisations, sans qu'il faille
         rejouer quoi que ce soit à la main. Les soldes, non — d'où RunAtLoad : un
         démarrage ou une ouverture de session en dehors des trois créneaux archive quand
         même la journée. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/powens-collector.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/powens-collector.err</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
