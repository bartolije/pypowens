<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copie hors site quotidienne de la base de production (voir scripts/backup-prod.sh).
     Installation : cp scripts/fr.jbartoli.powens-backup.plist ~/Library/LaunchAgents/
                    && launchctl load ~/Library/LaunchAgents/fr.jbartoli.powens-backup.plist
     Les identifiants vont dans ~/.config/pypowens/backup.env (chmod 600). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>fr.jbartoli.powens-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/Development/pypowens" &amp;&amp; scripts/backup-prod.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/powens-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/powens-backup.log</string>
</dict>
</plist>
